# MiniMax（国内 OpenAI 兼容接口）
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.cn/v1
OPENAI_MODEL=MiniMax-M3

# 搜索优先级：SearXNG > Tavily > DuckDuckGo
# 当前默认：树莓派 Tailscale SearXNG（不要用 :8080，树莓派上 8080 是 filebrowser）
# 后期可改成本机 Docker（http://127.0.0.1:8080）或其他搜索后端
SEARXNG_BASE_URL=http://100.120.153.107:8888
SEARCH_API_KEY=
API_TOKEN=
HOST=127.0.0.1
PORT=8000
